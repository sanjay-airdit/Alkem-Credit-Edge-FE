<mvc:View
    controllerName="creditedge.controller.DataView"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.f"
    xmlns:core="sap.ui.core"
    xmlns:smartTable="sap.ui.comp.smarttable"
    xmlns:smartFilterBar="sap.ui.comp.smartfilterbar"
    xmlns:customData="sap.ui.core.CustomData"
>
    <VBox>
        <HBox
            class="kpiRow sapUiTinyMargin"
            wrap="Wrap"
        >
            <!-- Total Orders -->
            <VBox class="kpiCard kpiCard--blue">
                <HBox
                    justifyContent="SpaceBetween"
                    alignItems="Center"
                >
                    <Text
                        text="Total Orders"
                        class="kpiTitle"
                    />
                    <core:Icon
                        src="sap-icon://sys-monitor"
                        class="kpiIcon kpiIcon--blue"
                    />
                </HBox>
                <Text
                    text="{kpiModel>/totalOrders}"
                    class="kpiValue kpiValue--blue"
                />
            </VBox>

            <!-- In Hold -->
            <VBox class="kpiCard kpiCard--orange">
                <HBox
                    justifyContent="SpaceBetween"
                    alignItems="Center"
                >
                    <Text
                        text="In Hold"
                        class="kpiTitle"
                    />
                    <core:Icon
                        src="sap-icon://pending"
                        class="kpiIcon kpiIcon--orange"
                    />
                </HBox>
                <Text
                    text="{kpiModel>/inHold}"
                    class="kpiValue kpiValue--orange"
                />
            </VBox>

            <!-- Approved -->
            <VBox class="kpiCard kpiCard--green">
                <HBox
                    justifyContent="SpaceBetween"
                    alignItems="Center"
                >
                    <Text
                        text="Approved"
                        class="kpiTitle"
                    />
                    <core:Icon
                        src="sap-icon://message-success"
                        class="kpiIcon kpiIcon--green"
                    />
                </HBox>
                <Text
                    text="{kpiModel>/approved}"
                    class="kpiValue kpiValue--green"
                />
            </VBox>

            <!-- High Risk Orders -->
            <VBox class="kpiCard kpiCard--red">
                <HBox
                    justifyContent="SpaceBetween"
                    alignItems="Center"
                >
                    <Text
                        text="High Risk Orders"
                        class="kpiTitle"
                    />
                    <core:Icon
                        src="sap-icon://alert"
                        class="kpiIcon kpiIcon--red"
                    />
                </HBox>
                <Text
                    text="{kpiModel>/highRiskOrders}"
                    class="kpiValue kpiValue--red"
                />
            </VBox>

            <!-- Avg Delay Score -->
            <VBox class="kpiCard kpiCard--purple">
                <HBox
                    justifyContent="SpaceBetween"
                    alignItems="Center"
                >
                    <Text
                        text="Avg Delay Score"
                        class="kpiTitle"
                    />
                    <core:Icon
                        src="sap-icon://history"
                        class="kpiIcon kpiIcon--purple"
                    />
                </HBox>
                <Text
                    text="{kpiModel>/avgDelayScore}"
                    class="kpiValue kpiValue--purple"
                />
            </VBox>

            <!-- Avg SOP Score -->
            <VBox class="kpiCard kpiCard--gold">
                <HBox
                    justifyContent="SpaceBetween"
                    alignItems="Center"
                >
                    <Text
                        text="Avg SOP Score"
                        class="kpiTitle"
                    />
                    <core:Icon
                        src="sap-icon://action-settings"
                        class="kpiIcon kpiIcon--gold"
                    />
                </HBox>
                <Text
                    text="{kpiModel>/avgSopScore}"
                    class="kpiValue kpiValue--gold"
                />
            </VBox>
        </HBox>

        <FlexBox
            justifyContent="End"
            class="sapUiTinyMarginBottom"
        >
            <SegmentedButton
                id="viewSwitchButton"
                selectedKey="list"
                selectionChange="onViewSwitchChange"
            >
                <items>
                    <SegmentedButtonItem
                        key="list"
                        icon="sap-icon://list"
                        tooltip="List View"
                    />
                    <SegmentedButtonItem
                        key="grid"
                        icon="sap-icon://grid"
                        tooltip="Grid View"
                    />
                </items>
            </SegmentedButton>
        </FlexBox>

        <!-- LIST VIEW: Smart Table -->
        <VBox
            id="listViewBox"
            visible="true"
        >
            <smartTable:SmartTable
                id="idSmartTable"
                entitySet="ZC_CE_OrdersOnHoldSet"
                tableType="Table"
                enableExport="true"
                beforeExport=".onBeforeExport"
                useVariantManagement="true"
                useTablePersonalisation="true"
                header="Order List"
                showRowCount="true"
                enableAutoBinding="true"
                enableAutoColumnWidth="true"
                beforeRebindTable="onBeforeRebindTable"
                height="100%"
            >
                <smartTable:customToolbar>
                    <Toolbar>
                        <ToolbarSpacer />
                        <!-- <SearchField
                            id="idOrderSearchField"
                            width="20rem"
                            search="onSearch"
                            liveChange="onSearchLiveChange"
                        /> -->
                    </Toolbar>
                </smartTable:customToolbar>
                <Table
                    id="idTableAccount"
                    mode="None"
                    growing="true"
                    growingScrollToLoad="true"
                    sticky="ColumnHeaders,HeaderToolbar,InfoToolbar"
                >
                    <columns>
                        <Column>
                            <customData>
                                <core:CustomData
                                    key="p13nData"
                                    value='\{"columnKey": "AISopValueScore","leadingProperty": "AISopValueScore", "sortProperty": "AISopValueScore", "filterProperty": "AISopValueScore", "columnIndex": "4"}'
                                />
                            </customData>
                            <Label
                                text="SOP Value Score"
                                wrapping="false"
                            />
                        </Column>
                        <Column>
                            <customData>
                                <core:CustomData
                                    key="p13nData"
                                    value='\{"columnKey": "AIAverageDelayScore","leadingProperty": "AIAverageDelayScore", "sortProperty": "AIAverageDelayScore", "filterProperty": "AIAverageDelayScore", "columnIndex": "5"}'
                                />
                            </customData>
                            <Label
                                text="Average Delay Score"
                                wrapping="false"
                            />
                        </Column>
                        <Column>
                            <customData>
                                <core:CustomData
                                    key="p13nData"
                                    value='\{"columnKey": "AIUtilPercentageScore","leadingProperty": "AIUtilPercentageScore", "sortProperty": "AIUtilPercentageScore", "filterProperty": "AIUtilPercentageScore", "columnIndex": "6"}'
                                />
                            </customData>
                            <Label
                                text="Utilization % Score"
                                wrapping="false"
                            />
                        </Column>
                        <Column hAlign="Center">
                            <customData>
                                <core:CustomData
                                    key="p13nData"
                                    value='\{"columnKey": "Grade","leadingProperty": "Grade", "sortProperty": "Grade", "filterProperty": "Grade", "columnIndex": "50"}'
                                />
                            </customData>
                            <Label
                                text="Actions"
                                wrapping="false"
                            />
                        </Column>
                    </columns>

                    <items>
                        <ColumnListItem vAlign="Middle">
                            <cells>
                                <ProgressIndicator
                                    class="sapUiSmallMarginBottom"
                                    percentValue="{path: 'AISopValueScore', formatter: '.formatter.percentValue'}"
                                    state="{path: 'AISopValueScore', formatter: '.formatter.stateValue'}"
                                    showValue="false"
                                />
                                <ProgressIndicator
                                    class="sapUiSmallMarginBottom"
                                    percentValue="{path: 'AIAverageDelayScore', formatter: '.formatter.percentValue'}"
                                    state="{path: 'AIAverageDelayScore', formatter: '.formatter.stateValue'}"
                                    showValue="false"
                                />
                                <ProgressIndicator
                                    class="sapUiSmallMarginBottom"
                                    percentValue="{path: 'AIUtilPercentageScore', formatter: '.formatter.percentValue'}"
                                    state="{path: 'AIUtilPercentageScore', formatter: '.formatter.stateValue'}"
                                    showValue="false"
                                />
                                <HBox justifyContent="SpaceAround">
                                    <Button
                                        icon="sap-icon://refresh"
                                        class="sapUiTinyMarginEnd"
                                        type="Emphasized"
                                    />
                                    <Button
                                        icon="sap-icon://accept"
                                        class="sapUiTinyMarginEnd"
                                        type="Accept"
                                    />
                                    <Button icon="sap-icon://decline" type="Reject"/>
                                </HBox>
                            </cells>
                        </ColumnListItem>
                    </items>
                </Table>
            </smartTable:SmartTable>
        </VBox>

        <!-- GRID VIEW -->
        <VBox
            id="gridViewBox"
            visible="false"
            class="sapUiSmallMarginTop"
            width="100%"
            busy="{ordersModel>/busy}"
            busyIndicatorDelay="0"
        >
            <!-- Scrollable card area -->
            <ScrollContainer
                id="idGridScrollContainer"
                height="59vh"
                width="100%"
                vertical="true"
                horizontal="false"
            >
                <FlexBox
                    id="idOrdersGridContainer"
                    wrap="Wrap"
                    justifyContent="Start"
                    items="{ordersModel>/orders}"
                >
                    <items>
                        <f:Card
                            width="19rem"
                            class="sapUiSmallMargin"
                        >
                            <f:content>
                                <VBox
                                    width="100%"
                                    class="sapUiSmallMargin"
                                >
                                    <!-- Header -->
                                    <HBox
                                        justifyContent="SpaceBetween"
                                        alignItems="Center"
                                        class="sapUiTinyMarginBottom"
                                    >
                                        <Title
                                            text="{ordersModel>OrderNumber}"
                                            class="sapUiFontHeader5"
                                        />
                                        <ObjectStatus
                                            text="{ordersModel>AITotalScoreText}"
                                            state="{path: 'ordersModel>AISopValueScore', formatter: '.formatter.stateValue'}"
                                        />
                                    </HBox>
                                    <Text
                                        text="Customer: {ordersModel>CustomerName}"
                                        class="sapUiTinyMarginBottom"
                                    />

                                    <!-- AI SUMMARY -->
                                    <VBox class="sapUiTinyMarginBottom">
                                        <HBox
                                            justifyContent="SpaceBetween"
                                            alignItems="Center"
                                        >
                                            <Label
                                                text="AI SUMMARY"
                                                design="Bold"
                                            />
                                            <ObjectStatus
                                                text="{ordersModel>RiskLevel}"
                                                state="{path: 'ordersModel>RiskLevel', formatter: '.formatter.riskState'}"
                                            />
                                        </HBox>
                                        <MessageStrip
                                            text="{ordersModel>AISummaryText}"
                                            type="{path: 'ordersModel>RiskLevel', formatter: '.formatter.riskState'}"
                                            showIcon="false"
                                            showCloseButton="false"
                                            class="sapUiTinyMarginTop"
                                        />
                                    </VBox>

                                    <!-- SUGGESTION -->
                                    <VBox class="sapUiTinyMarginBottom">
                                        <Label
                                            text="RECOMMENDATION"
                                            design="Bold"
                                        />
                                        <MessageStrip
                                            text="{ordersModel>AISummaryVerdict}"
                                            type="{path: 'ordersModel>AISummaryVerdict', formatter: '.formatter.riskState'}"
                                            showIcon="false"
                                            showCloseButton="false"
                                            class="sapUiTinyMarginTop"
                                        />
                                    </VBox>

                                    <!-- Scores -->
                                    <HBox
                                        justifyContent="SpaceBetween"
                                        class="sapUiTinyMarginBottom"
                                    >
                                        <VBox width="48%">
                                            <Label text="SOP Value Score" />
                                            <ProgressIndicator
                                                width="100%"
                                                percentValue="{path: 'ordersModel>AISopValueScore', formatter: '.formatter.percentValue'}"
                                                state="{path: 'ordersModel>AISopValueScore', formatter: '.formatter.stateValue'}"
                                                displayValue="{ordersModel>AISopValueScore}"
                                                showValue="true"
                                            />
                                        </VBox>
                                        <VBox width="48%">
                                            <Label text="AVG Delay Score" />
                                            <ProgressIndicator
                                                width="100%"
                                                percentValue="{path: 'ordersModel>AIAverageDelayScore', formatter: '.formatter.percentValue'}"
                                                state="{path: 'ordersModel>AIAverageDelayScore', formatter: '.formatter.stateValue'}"
                                                displayValue="{ordersModel>AIAverageDelayScore}"
                                                showValue="true"
                                            />
                                        </VBox>
                                    </HBox>
                                    <HBox
                                        justifyContent="SpaceBetween"
                                        class="sapUiTinyMarginBottom"
                                    >
                                        <VBox width="48%">
                                            <Label text="Utilization % Score" />
                                            <ProgressIndicator
                                                width="100%"
                                                percentValue="{path: 'ordersModel>AIUtilPercentageScore', formatter: '.formatter.percentValue'}"
                                                state="{path: 'ordersModel>AIUtilPercentageScore', formatter: '.formatter.stateValue'}"
                                                displayValue="{ordersModel>AIUtilPercentageScore}"
                                                showValue="true"
                                            />
                                        </VBox>
                                        <VBox width="48%">
                                            <Label text="Order Value" />
                                            <Text
                                                text="{ordersModel>CurrentOrderValue}"
                                            />
                                        </VBox>
                                    </HBox>

                                    <!-- Footer -->
                                    <HBox
                                        justifyContent="SpaceBetween"
                                        alignItems="Center"
                                        class="sapUiTinyMarginTop"
                                    >
                                        <VBox>
                                            <Text
                                                text="Credit Exposure: {ordersModel>CreditExposure}"
                                            />
                                            <Text
                                                text="Utilization: {ordersModel>UtilizationPercentage}"
                                            />
                                        </VBox>
                                        <HBox>
                                            <Button
                                                icon="sap-icon://refresh"
                                                type="Emphasized"
                                                class="sapUiTinyMarginEnd"
                                                press="onReset"
                                            />
                                            <Button
                                                icon="sap-icon://accept"
                                                type="Accept"
                                                class="sapUiTinyMarginEnd"
                                                press="onApprove"
                                            />
                                            <Button
                                                icon="sap-icon://decline"
                                                type="Reject"
                                                press="onReject"
                                            />
                                        </HBox>
                                    </HBox>
                                </VBox>
                            </f:content>
                        </f:Card>
                    </items>
                </FlexBox>

                <!-- No data / empty state (hidden while busy) -->
                <MessageStrip
                    visible="{= !${ordersModel>/busy} &amp;&amp; ${ordersModel>/noData} }"
                    text="No records found."
                    type="Information"
                    showIcon="true"
                    showCloseButton="false"
                    class="sapUiMediumMargin"
                />
            </ScrollContainer>

            <!-- Pagination bar, pinned at bottom of the grid area -->
            <Toolbar
                id="idGridPaginationToolbar"
                width="100%"
                class="sapUiTinyMarginTop"
            >
                <ToolbarSpacer />

                <!-- << : jump back 10 pages -->
                <Button
                    text="&lt;&lt;"
                    tooltip="Back 10 pages"
                    press="onGridJumpBack"
                    enabled="{= ${ordersModel>/currentPage} > 1 }"
                />

                <!-- Previous : back 1 page -->
                <Button
                    text="Previous"
                    press="onGridPrevPage"
                    enabled="{= ${ordersModel>/currentPage} > 1 }"
                />

                <OverflowToolbar
                    id="idPageNumbersToolbar"
                    width="auto"
                    content="{path: 'ordersModel>/pageNumbers'}"
                >
                    <Button
                        text="{ordersModel>text}"
                        press="onGridPageNumberPress"
                        enabled="{ordersModel>enabled}"
                        type="{= ${ordersModel>emphasized} ? 'Emphasized' : 'Transparent'}"
                    >
                        <customData>
                            <core:CustomData
                                key="page"
                                value="{ordersModel>page}"
                            />
                        </customData>
                    </Button>
                </OverflowToolbar>

                <!-- Next : forward 1 page -->
                <Button
                    text="Next"
                    press="onGridNextPage"
                    enabled="{= ${ordersModel>/currentPage} &lt; ${ordersModel>/totalPages} }"
                />

                <!-- >> : jump forward 10 pages -->
                <Button
                    text="&gt;&gt;"
                    tooltip="Forward 10 pages"
                    press="onGridJumpForward"
                    enabled="{= ${ordersModel>/currentPage} &lt; ${ordersModel>/totalPages} }"
                />

                <ToolbarSpacer />
                <Text text="{ordersModel>/totalCount} records" />
            </Toolbar>
        </VBox>
    </VBox>
</mvc:View>
