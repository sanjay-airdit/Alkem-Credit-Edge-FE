<mvc:View
    controllerName="creditedge.controller.DataView"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.f"
    xmlns:core="sap.ui.core"
    xmlns:smartTable="sap.ui.comp.smarttable"
    xmlns:smartFilterBar="sap.ui.comp.smartfilterbar"
    xmlns:customData="sap.ui.core.CustomData"
>
    <VBox>
        <HBox
            class="kpiRow sapUiTinyMargin"
            wrap="Wrap"
        >
            <!-- Total Orders -->
            <VBox class="kpiCard kpiCard--blue">
                <HBox
                    justifyContent="SpaceBetween"
                    alignItems="Center"
                >
                    <Text
                        text="Total Orders"
                        class="kpiTitle"
                    />
                    <core:Icon
                        src="sap-icon://sys-monitor"
                        class="kpiIcon kpiIcon--blue"
                    />
                </HBox>
                <Text
                    text="{kpiModel>/TotalOrders}"
                    class="kpiValue kpiValue--blue"
                />
            </VBox>

            <!-- In Hold -->
            <VBox class="kpiCard kpiCard--orange">
                <HBox
                    justifyContent="SpaceBetween"
                    alignItems="Center"
                >
                    <Text
                        text="In Hold"
                        class="kpiTitle"
                    />
                    <core:Icon
                        src="sap-icon://pending"
                        class="kpiIcon kpiIcon--orange"
                    />
                </HBox>
                <Text
                    text="{kpiModel>/InHold}"
                    class="kpiValue kpiValue--orange"
                />
            </VBox>

            <!-- Approved -->
            <VBox class="kpiCard kpiCard--green">
                <HBox
                    justifyContent="SpaceBetween"
                    alignItems="Center"
                >
                    <Text
                        text="Approved"
                        class="kpiTitle"
                    />
                    <core:Icon
                        src="sap-icon://message-success"
                        class="kpiIcon kpiIcon--green"
                    />
                </HBox>
                <Text
                    text="{kpiModel>/ApprovedOrders}"
                    class="kpiValue kpiValue--green"
                />
            </VBox>

            <!-- High Risk Orders -->
            <VBox class="kpiCard kpiCard--red">
                <HBox
                    justifyContent="SpaceBetween"
                    alignItems="Center"
                >
                    <Text
                        text="High Risk Orders"
                        class="kpiTitle"
                    />
                    <core:Icon
                        src="sap-icon://alert"
                        class="kpiIcon kpiIcon--red"
                    />
                </HBox>
                <Text
                    text="{kpiModel>/HighRiskOrders}"
                    class="kpiValue kpiValue--red"
                />
            </VBox>

            <!-- Avg Delay Score -->
            <VBox class="kpiCard kpiCard--purple">
                <HBox
                    justifyContent="SpaceBetween"
                    alignItems="Center"
                >
                    <Text
                        text="Avg Delay Score"
                        class="kpiTitle"
                    />
                    <core:Icon
                        src="sap-icon://history"
                        class="kpiIcon kpiIcon--purple"
                    />
                </HBox>
                <Text
                    text="{kpiModel>/AvgDelayScore}"
                    class="kpiValue kpiValue--purple"
                />
            </VBox>

            <!-- Avg SOP Score -->
            <!-- <VBox class="kpiCard kpiCardgold">
                <HBox
                    justifyContent="SpaceBetween"
                    alignItems="Center"
                >
                    <Text
                        text="Avg SOP Score"
                        class="kpiTitle"
                    />
                    <core:Icon
                        src="sap-icon://action-settings"
                        class="kpiIcongold"
                    />
                </HBox>
                <Text
                    text="{kpiModel>/avgSopScore}"
                    class="kpiValuegold"
                />
            </VBox> -->
        </HBox>

        <!-- =========================================================== -->
        <!-- FILTER PANEL - now a TOP-LEVEL sibling so it stays visible   -->
        <!-- regardless of whether List or Grid view is active           -->
        <!-- =========================================================== -->
        <Panel
            id="idFilterPanel"
            class="sapUiTinyMarginTop"
            expandable="false"
            expanded="true"
        >
            <headerToolbar>
                <OverflowToolbar style="Clear">
                    <Title
                        text="Filters"
                        level="H3"
                    />
                    <ToolbarSpacer />
                    <Button
                        id="idFilterGoButton"
                        text="Go"
                        type="Emphasized"
                        press="onFilterSearch"
                    />
                    <Button
                        id="idFilterClearButton"
                        text="Clear"
                        press="onFilterClear"
                    />
                    <SegmentedButton
                        id="viewSwitchButton"
                        selectedKey="list"
                        selectionChange="onViewSwitchChange"
                    >
                        <items>
                            <SegmentedButtonItem
                                key="list"
                                icon="sap-icon://list"
                                tooltip="List View"
                            />
                            <SegmentedButtonItem
                                key="grid"
                                icon="sap-icon://grid"
                                tooltip="Grid View"
                            />
                        </items>
                    </SegmentedButton>
                </OverflowToolbar>
            </headerToolbar>

            <FlexBox
                class="sapUiTinyMargin"
                wrap="Wrap"
                alignItems="End"
            >
                <VBox class="sapUiTinyMarginEnd sapUiSmallMarginBottom">
                    <Label
                        text="From Date"
                        labelFor="idFromDate"
                        required="true"
                    />
                    <DatePicker
                        id="idFromDate"
                        width="12rem"
                        valueFormat="yyyy-MM-dd"
                        dateValue="{filterModel>/fromDate}"
                    />
                </VBox>

                <VBox class="sapUiTinyMarginEnd sapUiSmallMarginBottom">
                    <Label
                        text="To Date"
                        labelFor="idToDate"
                        required="true"
                    />
                    <DatePicker
                        id="idToDate"
                        width="12rem"
                        valueFormat="yyyy-MM-dd"
                        dateValue="{filterModel>/toDate}"
                    />
                </VBox>

                <VBox class="sapUiTinyMarginEnd sapUiSmallMarginBottom">
                    <Label
                        text="Order Number"
                        labelFor="idOrderNumberFilter"
                    />
                    <Input
                        id="idOrderNumberFilter"
                        width="12rem"
                        placeholder="Order Number"
                        value="{filterModel>/orderNumber}"
                    />
                </VBox>

                <VBox class="sapUiTinyMarginEnd sapUiSmallMarginBottom">
                    <Label
                        text="Recommendation"
                        labelFor="idRecommendationFilter"
                    />
                    <Input
                        id="idRecommendationFilter"
                        width="12rem"
                        placeholder="e.g. Approve"
                        value="{filterModel>/recommendation}"
                    />
                </VBox>

                <VBox class="sapUiTinyMarginEnd sapUiSmallMarginBottom">
                    <Label
                        text="Customer"
                        labelFor="idCustomerFilter"
                    />
                    <Input
                        id="idCustomerFilter"
                        width="12rem"
                        placeholder="Customer"
                        value="{filterModel>/customer}"
                    />
                </VBox>

                <VBox class="sapUiTinyMarginEnd sapUiSmallMarginBottom">
                    <Label
                        text="Division"
                        labelFor="idDivisionFilter"
                    />
                    <Input
                        id="idDivisionFilter"
                        width="12rem"
                        placeholder="Division"
                        value="{filterModel>/division}"
                    />
                </VBox>

                <VBox class="sapUiTinyMarginEnd sapUiSmallMarginBottom">
                    <Label
                        text="Business Area"
                        labelFor="idBusinessAreaFilter"
                    />
                    <Input
                        id="idBusinessAreaFilter"
                        width="12rem"
                        placeholder="Business Area"
                        value="{filterModel>/businessArea}"
                    />
                </VBox>
            </FlexBox>
        </Panel>

        <!-- =========================================================== -->
        <!-- ICON TAB BAR - now a TOP-LEVEL sibling so it stays visible   -->
        <!-- regardless of whether List or Grid view is active.          -->
        <!-- Its <content> holds BOTH the list and grid view containers, -->
        <!-- and their individual visible="" bindings (managed by        -->
        <!-- onViewSwitchChange in the controller) decide which one      -->
        <!-- shows.                                                      -->
        <!-- =========================================================== -->
        <IconTabBar
            id="idStatusTabBar"
            selectedKey="{filterModel>/statusTab}"
            select="onStatusTabSelect"
            applyContentPadding="false"
            stretchContentHeight="true"
            class="sapUiTinyMarginBottom"
        >
            <items>
                <IconTabFilter
                    key="HOLD"
                    text="On Hold"
                />
                <IconTabFilter
                    key="REJECTED"
                    text="Rejected"
                />
            </items>

            <content>
                <!-- =============== LIST VIEW =============== -->
                <VBox
                    id="listViewBox"
                    visible="true"
                >
                    <smartTable:SmartTable
                        id="idSmartTable"
                        entitySet="ZC_CE_OrdersOnHoldSet"
                        tableType="Table"
                        enableExport="true"
                        beforeExport=".onBeforeExport"
                        header="Order List"
                        showRowCount="true"
                        enableAutoBinding="true"
                        enableAutoColumnWidth="true"
                        beforeRebindTable="onBeforeRebindTable"
                        height="100%"
                        width="100%"
                    >
                        <smartTable:customToolbar>
                            <Toolbar>
                                <ToolbarSpacer />
                            </Toolbar>
                        </smartTable:customToolbar>
                        <Table
                            id="idTableAccount"
                            mode="None"
                            growing="true"
                            growingScrollToLoad="true"
                            sticky="ColumnHeaders,HeaderToolbar,InfoToolbar"
                        >
                            <columns>
                                <Column width="28rem">
                                    <customData>
                                        <core:CustomData
                                            key="p13nData"
                                            value='\{"columnKey": "AISummaryText","leadingProperty": "AISummaryText", "sortProperty": "AISummaryText", "filterProperty": "AISummaryText", "columnIndex": "2"}'
                                        />
                                    </customData>
                                    <Label
                                        text="Summary"
                                        wrapping="false"
                                    />
                                </Column>
                                <Column hAlign="Center">
                                    <customData>
                                        <core:CustomData
                                            key="p13nData"
                                            value='\{"columnKey": "AISummaryVerdict","leadingProperty": "AISummaryVerdict", "sortProperty": "AISummaryVerdict", "filterProperty": "AISummaryVerdict", "columnIndex": "3"}'
                                        />
                                    </customData>
                                    <Label
                                        text="Recommendation"
                                        wrapping="false"
                                    />
                                </Column>
                                <Column>
                                    <customData>
                                        <core:CustomData
                                            key="p13nData"
                                            value='\{"columnKey": "AISopValueScore","leadingProperty": "AISopValueScore", "sortProperty": "AISopValueScore", "filterProperty": "AISopValueScore", "columnIndex": "4"}'
                                        />
                                    </customData>
                                    <Label
                                        text="SOP Value Score"
                                        wrapping="false"
                                    />
                                </Column>
                                <Column>
                                    <customData>
                                        <core:CustomData
                                            key="p13nData"
                                            value='\{"columnKey": "AIAverageDelayScore","leadingProperty": "AIAverageDelayScore", "sortProperty": "AIAverageDelayScore", "filterProperty": "AIAverageDelayScore", "columnIndex": "5"}'
                                        />
                                    </customData>
                                    <Label
                                        text="Average Delay Score"
                                        wrapping="false"
                                    />
                                </Column>
                                <Column>
                                    <customData>
                                        <core:CustomData
                                            key="p13nData"
                                            value='\{"columnKey": "AIUtilPercentageScore","leadingProperty": "AIUtilPercentageScore", "sortProperty": "AIUtilPercentageScore", "filterProperty": "AIUtilPercentageScore", "columnIndex": "6"}'
                                        />
                                    </customData>
                                    <Label
                                        text="Utilization % Score"
                                        wrapping="false"
                                    />
                                </Column>
                                <Column
                                    hAlign="Center"
                                    width="8rem"
                                >
                                    <customData>
                                        <core:CustomData
                                            key="p13nData"
                                            value='\{"columnKey": "Grade","leadingProperty": "Grade", "sortProperty": "Grade", "filterProperty": "Grade", "columnIndex": "50"}'
                                        />
                                    </customData>
                                    <Label
                                        text="Actions"
                                        wrapping="false"
                                    />
                                </Column>
                            </columns>

                            <items>
                                <ColumnListItem vAlign="Middle">
                                    <cells>
                                        <FormattedText
                                            htmlText="{path: 'AISummaryText', formatter: '.formatSummaryHtml'}"
                                        />
                                        <ObjectStatus
                                            text="{AISummaryVerdict}"
                                            state="{path: 'AISummaryVerdict', formatter: '.formatter.riskState'}"
                                            inverted="true"
                                        />
                                        <ProgressIndicator
                                            class="sapUiSmallMarginBottom"
                                            percentValue="{path: 'AISopValueScore', formatter: '.formatter.percentValue'}"
                                            state="{path: 'AISopValueScore', formatter: '.formatter.stateValue'}"
                                            showValue="false"
                                        />
                                        <ProgressIndicator
                                            class="sapUiSmallMarginBottom"
                                            percentValue="{path: 'AIAverageDelayScore', formatter: '.formatter.percentValue'}"
                                            state="{path: 'AIAverageDelayScore', formatter: '.formatter.stateValue'}"
                                            showValue="false"
                                        />
                                        <ProgressIndicator
                                            class="sapUiSmallMarginBottom"
                                            percentValue="{path: 'AIUtilPercentageScore', formatter: '.formatter.percentValue'}"
                                            state="{path: 'AIUtilPercentageScore', formatter: '.formatter.stateValue'}"
                                            showValue="false"
                                        />
                                        <HBox justifyContent="SpaceAround">
                                            <Button
                                                icon="sap-icon://show"
                                                class="sapUiTinyMarginEnd"
                                                type="Emphasized"
                                                press="onView"
                                            />
                                            <Button
                                                icon="sap-icon://accept"
                                                class="sapUiTinyMarginEnd"
                                                type="Accept"
                                                press="onApprove"
                                                visible="{= ${status} !== 'REJECTED'}"
                                            />
                                            <Button
                                                icon="sap-icon://decline"
                                                type="Reject"
                                                press="onReject"
                                                visible="{= ${status} !== 'REJECTED'}"
                                            />
                                            <Button
                                                icon="sap-icon://refresh"
                                                type="Emphasized"
                                                press="onReInitiate"
                                                visible="{= ${status} === 'REJECTED'}"
                                            />
                                        </HBox>
                                    </cells>
                                </ColumnListItem>
                            </items>
                        </Table>
                    </smartTable:SmartTable>
                </VBox>

                <!-- =============== GRID VIEW =============== -->
                <VBox
                    id="gridViewBox"
                    visible="false"
                    class="sapUiSmallMarginTop"
                    width="100%"
                    busy="{ordersModel>/busy}"
                    busyIndicatorDelay="0"
                >
                    <ScrollContainer
                        id="idGridScrollContainer"
                        width="100%"
                        vertical="true"
                        horizontal="false"
                    >
                        <FlexBox
                            id="idOrdersGridContainer"
                            wrap="Wrap"
                            justifyContent="Start"
                            items="{ordersModel>/orders}"
                        >
                            <items>
                                <f:Card
                                    width="90%"
                                    class="sapUiSmallMargin"
                                >
                                    <f:layoutData>
                                        <FlexItemData
                                            growFactor="1"
                                            minWidth="26rem"
                                            maxWidth="26rem"
                                        />
                                    </f:layoutData>

                                    <f:content>
                                        <VBox
                                            width="100%"
                                            class="sapUiSmallMargin"
                                        >
                                            <HBox
                                                justifyContent="SpaceBetween"
                                                alignItems="Center"
                                                class="sapUiTinyMarginBottom"
                                            >
                                                <Title
                                                    text="{ordersModel>OrderNumber}"
                                                    class="sapUiFontHeader5"
                                                />
                                                <ObjectStatus
                                                    text="{= ${ordersModel>AISopValueScore} !== undefined &amp;&amp; ${ordersModel>AISopValueScore} !== null &amp;&amp; ${ordersModel>AISopValueScore} !== '' ? ${ordersModel>AISopValueScore} + ' / 5' : ''}"
                                                    state="{path: 'ordersModel>AISopValueScore', formatter: '.formatter.stateValue'}"
                                                    inverted="true"
                                                />
                                            </HBox>
                                            <Text
                                                text="Customer: {ordersModel>Customer}"
                                                class="sapUiTinyMarginBottom"
                                            />

                                            <!-- AI SUMMARY -->
                                            <VBox class="sapUiTinyMarginBottom">
                                                <HBox
                                                    justifyContent="SpaceBetween"
                                                    alignItems="Center"
                                                >
                                                    <Label
                                                        text="AI SUMMARY"
                                                        design="Bold"
                                                    />
                                                    <ObjectStatus
                                                        text="{ordersModel>AISummaryVerdict}"
                                                        state="{path: 'ordersModel>AISummaryVerdict', formatter: '.formatter.riskState'}"
                                                        inverted="true"
                                                    />
                                                </HBox>
                                                <ScrollContainer
                                                    height="12rem"
                                                    width="100%"
                                                    vertical="true"
                                                    horizontal="false"
                                                    class="sapUiTinyMarginTop"
                                                >
                                                    <FormattedText
                                                        htmlText="{path: 'ordersModel>AISummaryText', formatter: '.formatSummaryHtml'}"
                                                    />
                                                </ScrollContainer>
                                            </VBox>

                                            <!-- SUGGESTION -->
                                            <!-- <VBox class="sapUiTinyMarginBottom">
                                                <Label
                                                    text="RECOMMENDATION"
                                                    design="Bold"
                                                />
                                                <MessageStrip
                                                    text="{ordersModel>AISummaryVerdict}"
                                                    type="{path: 'ordersModel>AISummaryVerdict', formatter: '.formatter.riskState'}"
                                                    showIcon="false"
                                                    showCloseButton="false"
                                                    class="sapUiTinyMarginTop"
                                                />
                                            </VBox> -->

                                            <!-- Scores -->
                                            <HBox
                                                justifyContent="SpaceBetween"
                                                class="sapUiTinyMarginBottom"
                                            >
                                                <VBox width="48%">
                                                    <Label
                                                        text="SOP Value Score"
                                                    />
                                                    <ProgressIndicator
                                                        width="100%"
                                                        percentValue="{path: 'ordersModel>AISopValueScore', formatter: '.formatter.percentValue'}"
                                                        state="{path: 'ordersModel>AISopValueScore', formatter: '.formatter.stateValue'}"
                                                        displayValue="{ordersModel>AISopValueScore}"
                                                        showValue="true"
                                                    />
                                                </VBox>
                                                <VBox width="48%">
                                                    <Label
                                                        text="AVG Delay Score"
                                                    />
                                                    <ProgressIndicator
                                                        width="100%"
                                                        percentValue="{path: 'ordersModel>AIAverageDelayScore', formatter: '.formatter.percentValue'}"
                                                        state="{path: 'ordersModel>AIAverageDelayScore', formatter: '.formatter.stateValue'}"
                                                        displayValue="{ordersModel>AIAverageDelayScore}"
                                                        showValue="true"
                                                    />
                                                </VBox>
                                            </HBox>
                                            <HBox
                                                justifyContent="SpaceBetween"
                                                class="sapUiTinyMarginBottom"
                                            >
                                                <VBox width="48%">
                                                    <Label
                                                        text="Utilization % Score"
                                                    />
                                                    <ProgressIndicator
                                                        width="100%"
                                                        percentValue="{path: 'ordersModel>AIUtilPercentageScore', formatter: '.formatter.percentValue'}"
                                                        state="{path: 'ordersModel>AIUtilPercentageScore', formatter: '.formatter.stateValue'}"
                                                        displayValue="{ordersModel>AIUtilPercentageScore}"
                                                        showValue="true"
                                                    />
                                                </VBox>
                                                <VBox width="48%">
                                                    <Label text="Order Value" />
                                                    <Text
                                                        text="{ordersModel>CurrentOrderValue}"
                                                    />
                                                </VBox>
                                            </HBox>

                                            <!-- Footer -->
                                            <HBox
                                                justifyContent="SpaceBetween"
                                                alignItems="Center"
                                                class="sapUiTinyMarginTop"
                                            >
                                                <VBox>
                                                    <Text
                                                        text="Credit Exposure: {ordersModel>CreditEsposure}"
                                                    />
                                                    <Text
                                                        text="Utilization: {ordersModel>AIUtilizationPercentage}"
                                                    />
                                                </VBox>
                                                <HBox>
                                                    <Button
                                                        icon="sap-icon://show"
                                                        type="Emphasized"
                                                        class="sapUiTinyMarginEnd"
                                                        press="onView"
                                                    />
                                                    <Button
                                                        icon="sap-icon://accept"
                                                        type="Accept"
                                                        class="sapUiTinyMarginEnd"
                                                        press="onApprove"
                                                        visible="{= ${ordersModel>status} !== 'REJECTED'}"
                                                    />
                                                    <Button
                                                        icon="sap-icon://decline"
                                                        type="Reject"
                                                        press="onReject"
                                                        visible="{= ${ordersModel>status} !== 'REJECTED'}"
                                                    />
                                                    <Button
                                                        icon="sap-icon://refresh"
                                                        type="Emphasized"
                                                        press="onReInitiate"
                                                        visible="{= ${ordersModel>status} === 'REJECTED'}"
                                                    />
                                                </HBox>
                                            </HBox>
                                        </VBox>
                                    </f:content>
                                </f:Card>
                            </items>
                        </FlexBox>

                        <MessageStrip
                            visible="{= !${ordersModel>/busy} &amp;&amp; ${ordersModel>/noData} }"
                            text="No records found."
                            type="Information"
                            showIcon="true"
                            showCloseButton="false"
                            class="sapUiMediumMargin"
                        />

                        <VBox
                            visible="{uiState>/gridActive}"
                            height="4rem"
                        />
                    </ScrollContainer>
                </VBox>
            </content>
        </IconTabBar>
    </VBox>
</mvc:View>
