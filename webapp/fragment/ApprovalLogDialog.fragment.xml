<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
>
    <Dialog
        id="idApprovalLogDialog"
        title="Approval Log"
        contentWidth="50%"
        verticalScrolling="true"
    >
        <content>
            <Table
                id="idApprovalLogTable"
                items="{logModel>/logs}"
                noDataText="No log entries found."
            >
                <columns>
                    <Column>
                        <Text text="Level" />
                    </Column>
                    <Column>
                        <Text text="Action" />
                    </Column>
                    <Column>
                        <Text text="User" />
                    </Column>
                    <Column hAlign="End">
                        <Text text="Action Time" />
                    </Column>
                </columns>
                <items>
                    <ColumnListItem>
                        <cells>
                            <Text text="{logModel>ApprovalLevel}" />
                            <ObjectStatus
                                text="{logModel>ActionPerformed}"
                                state="{path: 'logModel>ActionPerformed', formatter: '.formatter.actionState'}"
                                inverted="true"
                            />
                            <Text text="{logModel>ActionBy}" />
                            <Text
                                text="{ path: 'logModel>ActionWhen', type: 'sap.ui.model.type.DateTime'}"
                            />
                        </cells>
                    </ColumnListItem>
                </items>
            </Table>
        </content>
        <beginButton>
            <Button
                text="Close"
                press="onCloseApprovalLog"
            />
        </beginButton>
    </Dialog>
</core:FragmentDefinition>
