<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
>
    <Dialog
        id="commentDialog"
        title="{commentModel>/title}"
        contentWidth="28rem"
    >
        <content>
            <VBox class="sapUiSmallMargin">
                <Label
                    text="Comment"
                    required="true"
                    labelFor="commentTextArea"
                />
                <TextArea
                    id="commentTextArea"
                    width="100%"
                    rows="4"
                    maxLength="500"
                    value="{commentModel>/comment}"
                    valueState="{commentModel>/valueState}"
                    valueStateText="{commentModel>/valueStateText}"
                    liveChange="onCommentLiveChange"
                />
            </VBox>
        </content>
        <beginButton>
            <Button
                text="{commentModel>/confirmButtonText}"
                type="Emphasized"
                press="onCommentDialogConfirm"
            />
        </beginButton>
        <endButton>
            <Button
                text="Cancel"
                press="onCommentDialogCancel"
            />
        </endButton>
    </Dialog>
</core:FragmentDefinition>
